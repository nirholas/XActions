# Cloudflare Pages custom headers
# Security headers for all pages

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Nothing here is content-hashed: /js/sidebar.js keeps its name across every
# deploy. A year of `immutable` meant a browser kept running last year's script
# against this year's HTML and API, with no way to reach it short of renaming
# the file. Scripts and styles are cached for five minutes and revalidated
# after; images change rarely and are only ever wrong-looking, not broken, so
# they get a day. If a build step ever emits hashed filenames, give that path
# the year-long immutable rule and nothing else.
/js/*
  Cache-Control: public, max-age=300, must-revalidate

/*.css
  Cache-Control: public, max-age=300, must-revalidate

/*.png
  Cache-Control: public, max-age=86400

/*.svg
  Cache-Control: public, max-age=86400

/*.ico
  Cache-Control: public, max-age=86400
