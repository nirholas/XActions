{
  "name": "@xspace/widget",
  "version": "0.1.0",
  "description": "Embeddable voice chat widget for XSpace Agent servers",
  "main": "dist/xspace-widget.umd.js",
  "module": "dist/xspace-widget.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.3.3",
    "vite": "^8.1.6",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "nanoid@<3.3.12": "^3.3.12",
    "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
    "postcss@<8.5.23": "^8.5.23",
    "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
    "vite@<6.4.4": "^6.4.4",
    "vitest@>=2.1.0 <4.1.11": "^4.1.11"
  }
}
