{
  "name": "xspace-agent",
  "version": "0.2.0",
  "description": "TypeScript SDK for AI agents in X/Twitter Spaces — join, listen, speak, and respond with LLM-powered bots",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./cicd": {
      "types": "./dist/cicd/index.d.ts",
      "import": "./dist/cicd/index.js",
      "require": "./dist/cicd/index.js"
    },
    "./dist/tenant": {
      "types": "./dist/tenant/index.d.ts",
      "import": "./dist/tenant/index.js",
      "require": "./dist/tenant/index.js"
    },
    "./dist/voice": {
      "types": "./dist/voice/index.d.ts",
      "import": "./dist/voice/index.js",
      "require": "./dist/voice/index.js"
    },
    "./dist/events": {
      "types": "./dist/events/index.d.ts",
      "import": "./dist/events/index.js",
      "require": "./dist/events/index.js"
    },
    "./dist/browser/selector-engine": {
      "types": "./dist/browser/selector-engine.d.ts",
      "import": "./dist/browser/selector-engine.js",
      "require": "./dist/browser/selector-engine.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs": "typedoc",
    "db:migrate": "ts-node src/db/migrate.ts migrate",
    "db:seed": "ts-node src/db/migrate.ts seed"
  },
  "keywords": [
    "twitter",
    "x",
    "spaces",
    "ai",
    "agent",
    "bot",
    "voice",
    "puppeteer",
    "llm",
    "openai",
    "claude",
    "groq",
    "tts",
    "stt",
    "speech"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@node-saml/passport-saml": "^5.0.0",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.71.0",
    "drizzle-orm": "^0.45.2",
    "form-data": "^4.0.6",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "openid-client": "^5.7.1",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "puppeteer": "^25.16.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/ioredis": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.11.0",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.20.0",
    "@types/pino": "^7.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@vitest/coverage-v8": "^4.1.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "typedoc": "^0.28.18",
    "typescript": "^5.9.3",
    "vite": "^8.1.6",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@anthropic-ai/sdk@>=0.79.0 <0.91.1": "^0.91.1",
    "@vitest/mocker@>=2.1.0 <4.1.12": "^4.1.12",
    "@xmldom/xmldom@<0.8.15": "^0.8.15",
    "axios@<0.34.0": "^0.34.0",
    "axios@>=1.0.0 <1.20.0": "^1.20.0",
    "basic-ftp@<6.2.1": "^6.2.1",
    "brace-expansion@<1.1.21": "^1.1.21",
    "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
    "brace-expansion@>=3.0.0 <5.0.12": "^5.0.12",
    "debug@>=4.0.0 <4.3.1": "^4.3.1",
    "drizzle-orm@<0.45.2": "^0.45.2",
    "esbuild@<0.28.1": "^0.28.1",
    "fast-copy@>=4.0.0 <4.1.0": "^4.1.0",
    "follow-redirects@<1.16.0": "^1.16.0",
    "form-data@<2.5.6": "^2.5.6",
    "form-data@>=4.0.0 <4.0.6": "^4.0.6",
    "glob@>=9.0.0 <14.0.2": "^14.0.2",
    "ip-address@<10.7.4": "^10.7.4",
    "js-yaml@<3.15.2": "^3.15.2",
    "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
    "linkify-it@<5.0.2": "^5.0.2",
    "markdown-it@<14.3.3": "^14.3.3",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
    "nanoid@<3.3.12": "^3.3.12",
    "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
    "postcss@<8.5.23": "^8.5.23",
    "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
    "vite@<6.4.4": "^6.4.4",
    "vitest@>=2.1.0 <4.1.11": "^4.1.11",
    "ws@>=1.1.0 <5.2.5": "^5.2.5",
    "ws@>=7.0.0 <7.5.11": "^7.5.11",
    "ws@>=8.0.0 <8.21.0": "^8.21.0",
    "zod@>=4.0.0 <4.6.6": "^4.6.6"
  }
}
