{
  "name": "xspace-agent-monorepo",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server/index.js",
  "types": "dist/server/index.d.ts",
  "files": [
    "dist/",
    "public/",
    "x-spaces/"
  ],
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "puppeteer"
    ],
    "overrides": {
      "cross-spawn": "^7.0.6",
      "tmp": "^0.2.6",
      "tough-cookie": "^5.1.2",
      "uuid": "^11.1.1",
      "got": "^11.8.6",
      "posthog-node>axios": "^1.21.0"
    }
  },
  "scripts": {
    "build": "turbo build",
    "build:legacy": "npx tsc && npx vite build",
    "build:server": "npx tsc",
    "build:client": "npx vite build",
    "dev": "npx tsx watch packages/server/src/index.ts",
    "dev:legacy": "npx tsx watch src/server/index.ts",
    "start": "node dist/server/index.js",
    "start:legacy": "node server.js",
    "lint": "npx eslint src/",
    "lint:fix": "npx eslint src/ --fix",
    "typecheck": "npx tsc --noEmit && npx tsc -p tsconfig.client.json --noEmit",
    "test": "cd packages/core && npx --no-install vitest run",
    "format": "npx prettier --write \"src/**/*.ts\"",
    "format:check": "npx prettier --check \"src/**/*.ts\"",
    "docker:build": "docker build -t xspace-agent .",
    "docker:run": "docker run --env-file .env -p 3000:3000 --shm-size=2gb xspace-agent",
    "docker:up": "docker compose up -d",
    "docker:up:monitoring": "docker compose --profile with-monitoring up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f agent",
    "security": "npm audit --audit-level=high",
    "security:audit": "npm audit --audit-level=high",
    "db:migrate": "pnpm -F xspace-agent run db:migrate",
    "db:seed": "pnpm -F xspace-agent run db:seed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "axios": "^1.21.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "form-data": "^4.0.6",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "puppeteer": "^25.16.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.9",
    "@types/supertest": "^7.2.1",
    "artillery": "^2.0.34",
    "artillery-engine-socketio-v3": "^1.2.0",
    "eslint": "^9.39.5",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "cross-spawn": "^7.0.6",
    "tmp": "^0.2.6",
    "tough-cookie": "^5.1.2",
    "uuid": "^11.1.1",
    "got": "^11.8.6",
    "posthog-node": {
      "axios": "^1.21.0"
    }
  }
}
